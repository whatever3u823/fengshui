# ─────────────────────────────────────────────────────────────────────────────
# Feng Shui AI — environment variables
# Copy to .env.local and fill in. All keys are read server-side only.
#
# With NO keys set, the app runs in Demo Mode (sample room + pre-written
# analysis, clearly labeled). Nothing below is required to try the UX.
# ─────────────────────────────────────────────────────────────────────────────

# Stage 1 — room analysis (vision model, structured JSON output).
# Default provider. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Stage 2 — photo editing (gpt-image-2 by default). Also usable for analysis.
# Required for the optimized image. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Signs the analysis returned by /api/analyze-room so /api/optimize-room only
# accepts analyses this server produced for that exact photo.
# REQUIRED in production when running more than one server instance.
# Generate with: openssl rand -hex 32
ANALYSIS_TOKEN_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Which provider analyzes the photo: "anthropic" (default when its key is set) or "openai".
# ANALYSIS_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_ANALYSIS_MODEL=gpt-5.5
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=high          # low | medium | high

# Force Demo Mode even when keys are present.
# DEMO_MODE=true

# Limits
# MAX_UPLOAD_MB=10
# ANALYSIS_TIMEOUT_SECONDS=120
# IMAGE_TIMEOUT_SECONDS=240
# RATE_LIMIT_MAX_REQUESTS=20         # per IP, per window, per endpoint
# RATE_LIMIT_WINDOW_SECONDS=600
